    "prepublishOnly": "node scripts/check-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "doubao",
    "video",
    "windows",
    "stdio"
  ]
